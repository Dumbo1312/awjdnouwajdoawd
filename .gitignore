# qmake / make build output
*.o
Makefile
moc_*.cpp
qrc_*.cpp
ui_*.h
*.qrc.depends
.qmake.stash

# in-tree build products, named by path so they do not shadow the
# UEFIPatch/ and UEFIReplace/ source directories
/UEFITool-0.28.0/UEFITool
/UEFITool-0.28.0/UEFIPatch/UEFIPatch
/UEFITool-0.28.0/UEFIReplace/UEFIReplace
/tests/guicheck/guicheck

# firmware dumps and patched images: never commit somebody's BIOS
*.bin
*.rom
*.cap
*.fd
*.patched
*.dump/
mega_file
RIven_extracted/
