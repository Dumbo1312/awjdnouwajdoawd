<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Overlay"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="40dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A floating AI chat bubble that works over any app"
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Claude API Key"
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="sk-ant-..."
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:inputType="textPassword"
        android:textSize="14sp"
        android:fontFamily="monospace" />

    <Button
        android:id="@+id/btnSaveKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save API Key"
        android:backgroundTint="#2A2A2A"
        android:textColor="#AAAAAA"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnStartOverlay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Start Overlay"
        android:textSize="16sp"
        android:backgroundTint="#6200EE"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnStopOverlay"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Stop Overlay"
        android:backgroundTint="#333333"
        android:textColor="#AAAAAA" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Tap the purple bubble to open/close chat\n• Drag the bubble to reposition it\n• Overlay works on top of all apps\n• Chat history is kept during the session"
        android:textColor="#888888"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginTop="32dp" />

</LinearLayout>
