	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6A6A70", "fontStyle": "italic" } },
		{ "scope": ["string", "string.quoted", "constant.other.symbol"], "settings": { "foreground": "#FFD88A" } },
		{ "scope": ["string.regexp"], "settings": { "foreground": "#FFE07A" } },
		{ "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#FFB347" } },
		{ "scope": ["constant.language.boolean", "constant.language.null"], "settings": { "foreground": "#FFB347" } },
		{ "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#FFD54A", "fontStyle": "bold" } },
		{ "scope": ["keyword.operator", "punctuation.separator"], "settings": { "foreground": "#CFCFD1" } },
		{ "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#FFE07A" } },
		{ "scope": ["entity.name.class", "entity.name.type", "entity.other.inherited-class", "support.class", "support.type"], "settings": { "foreground": "#FFB347" } },
		{ "scope": ["variable", "variable.other", "variable.parameter"], "settings": { "foreground": "#ECECEC" } },
		{ "scope": ["variable.language"], "settings": { "foreground": "#FFB347", "fontStyle": "italic" } },
		{ "scope": ["entity.name.tag", "entity.other.attribute-name"], "settings": { "foreground": "#FFD54A" } },
		{ "scope": ["markup.heading", "markup.bold"], "settings": { "foreground": "#FFD54A", "fontStyle": "bold" } },
		{ "scope": ["markup.italic"], "settings": { "foreground": "#ECECEC", "fontStyle": "italic" } },
		{ "scope": ["markup.inline.raw"], "settings": { "foreground": "#FFD88A" } },
		{ "scope": ["markup.underline.link"], "settings": { "foreground": "#FFD54A" } },
		{ "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FF6E6E", "fontStyle": "underline" } }
	]
}
