{
	"$schema": "vscode://schemas/color-theme",
	"name": "Arceus Light",
	"type": "light",
	"semanticHighlighting": true,
	"colors": {
		"foreground": "#1A1A1A",
		"descriptionForeground": "#6A6A70",
		"focusBorder": "#CA9500",
		"widget.border": "#E3E3E6",
		"widget.shadow": "#00000022",
		"selection.background": "#FFD54A66",
		"textLink.foreground": "#A47700",
		"textLink.activeForeground": "#8A6500",
		"errorForeground": "#C83A4A",
		"editorError.foreground": "#C83A4A",
		"editorWarning.foreground": "#A47700",
		"editorInfo.foreground": "#2C6EB5",
		"editor.background": "#FFFBF0",
		"editor.foreground": "#1A1A1A",
		"editorCursor.foreground": "#A47700",
		"editor.lineHighlightBackground": "#FFF4CF",
		"editor.selectionBackground": "#FFD54A66",
		"editor.selectionHighlightBackground": "#FFD54A33",
		"editorLineNumber.foreground": "#B6B2A0",
		"editorLineNumber.activeForeground": "#A47700",
		"editorIndentGuide.background1": "#F0E8C7",
		"editorIndentGuide.activeBackground1": "#D6CA85",
		"editorBracketMatch.border": "#CA9500",
		"editorGutter.addedBackground": "#4B9A4B",
		"editorGutter.modifiedBackground": "#CA9500",
		"editorGutter.deletedBackground": "#C83A4A",
		"editorWidget.background": "#FFFBF0",
		"editorWidget.border": "#E3DCB0",
		"editorHoverWidget.background": "#FFFBF0",
		"editorHoverWidget.border": "#E3DCB0",
		"editorSuggestWidget.background": "#FFFBF0",
		"editorSuggestWidget.border": "#E3DCB0",
		"editorSuggestWidget.selectedBackground": "#FFEEA8",
		"editorSuggestWidget.selectedForeground": "#1A1A1A",
		"editorSuggestWidget.highlightForeground": "#A47700",
		"editorGhostText.foreground": "#1A1A1A80",
		"editorGroupHeader.tabsBackground": "#FFF4CF",
		"editorGroupHeader.tabsBorder": "#E3DCB0",
		"editorGroup.border": "#E3DCB0",
		"tab.activeBackground": "#FFFBF0",
		"tab.activeForeground": "#A47700",
		"tab.inactiveBackground": "#FFF4CF",
		"tab.inactiveForeground": "#6A6A70",
		"tab.activeBorderTop": "#CA9500",
		"tab.hoverBackground": "#FFEEA8",
		"sideBar.background": "#FFF4CF",
		"sideBar.foreground": "#1A1A1A",
		"sideBar.border": "#E3DCB0",
		"sideBarTitle.foreground": "#A47700",
		"sideBarSectionHeader.background": "#FFF4CF",
		"sideBarSectionHeader.foreground": "#A47700",
		"activityBar.background": "#FFF4CF",
		"activityBar.foreground": "#A47700",
		"activityBar.inactiveForeground": "#B6B2A0",
		"activityBar.border": "#E3DCB0",
		"activityBar.activeBorder": "#CA9500",
		"activityBarBadge.background": "#CA9500",
		"activityBarBadge.foreground": "#FFFBF0",
		"titleBar.activeBackground": "#FFF4CF",
		"titleBar.activeForeground": "#1A1A1A",
		"titleBar.border": "#E3DCB0",
		"statusBar.background": "#FFF4CF",
		"statusBar.foreground": "#6A6A70",
		"statusBar.border": "#E3DCB0",
		"statusBar.debuggingBackground": "#CA9500",
		"statusBar.debuggingForeground": "#FFFBF0",
		"statusBarItem.hoverBackground": "#FFEEA8",
		"panel.background": "#FFF4CF",
		"panel.border": "#E3DCB0",
		"panelTitle.activeForeground": "#A47700",
		"panelTitle.activeBorder": "#CA9500",
		"terminal.background": "#FFF4CF",
		"terminal.foreground": "#1A1A1A",
		"terminal.ansiBlack": "#1A1A1A",
		"terminal.ansiRed": "#C83A4A",
		"terminal.ansiGreen": "#4B9A4B",
		"terminal.ansiYellow": "#A47700",
		"terminal.ansiBlue": "#2C6EB5",
		"terminal.ansiMagenta": "#8A4FA8",
		"terminal.ansiCyan": "#2A8A95",
		"terminal.ansiWhite": "#ECECEC",
		"terminal.ansiBrightYellow": "#CA9500",
		"input.background": "#FFFBF0",
		"input.foreground": "#1A1A1A",
		"input.border": "#E3DCB0",
		"inputOption.activeBorder": "#CA9500",
		"inputOption.activeBackground": "#FFEEA866",
		"dropdown.background": "#FFFBF0",
		"dropdown.border": "#E3DCB0",
		"button.background": "#CA9500",
		"button.foreground": "#FFFBF0",
		"button.hoverBackground": "#A47700",
		"button.secondaryBackground": "#FFEEA8",
		"button.secondaryForeground": "#1A1A1A",
		"badge.background": "#CA9500",
		"badge.foreground": "#FFFBF0",
		"progressBar.background": "#CA9500",
		"list.hoverBackground": "#FFEEA866",
		"list.activeSelectionBackground": "#FFD54A",
		"list.activeSelectionForeground": "#1A1A1A",
		"list.highlightForeground": "#A47700",
		"menu.background": "#FFFBF0",
		"menu.foreground": "#1A1A1A",
		"menu.selectionBackground": "#FFEEA8",
		"menu.selectionForeground": "#1A1A1A",
		"menu.border": "#E3DCB0",
		"quickInput.background": "#FFFBF0",
		"quickInputList.focusBackground": "#FFEEA8"
	},
	"tokenColors": [
		{ "scope": ["comment"], "settings": { "foreground": "#8A8A70", "fontStyle": "italic" } },
		{ "scope": ["string"], "settings": { "foreground": "#A05F00" } },
		{ "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#8A4FA8" } },
		{ "scope": ["keyword", "storage"], "settings": { "foreground": "#A47700", "fontStyle": "bold" } },
		{ "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#6D4A00" } },
		{ "scope": ["entity.name.class", "entity.name.type"], "settings": { "foreground": "#8A4FA8" } },
		{ "scope": ["variable"], "settings": { "foreground": "#1A1A1A" } },
		{ "scope": ["entity.name.tag", "entity.other.attribute-name"], "settings": { "foreground": "#A47700" } },
		{ "scope": ["markup.heading"], "settings": { "foreground": "#A47700", "fontStyle": "bold" } }
	]
}
