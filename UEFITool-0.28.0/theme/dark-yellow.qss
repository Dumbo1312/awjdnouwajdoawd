/* UEFITool yellow on black theme.
 *
 * Palette, kept in one place so it can be reasoned about:
 *
 *   #0b0b0d  window background          #e6e4dc  body text
 *   #141417  panel background           #9a978c  dimmed text
 *   #1c1c21  raised / alternating row   #ffc400  accent yellow
 *   #2a2a1c  hover                      #ffd453  accent yellow, lighter
 *   #3a3a2e  border                     #ff8a3d  warning orange
 *   #121212  text on an accent fill
 *
 * The accent is only ever used on a near black background, and anything
 * drawn on an accent fill uses #121212, so both directions stay well
 * above a 4.5:1 contrast ratio.
 *
 * Panels are drawn with rgba fills rather than solid colours, so they sit
 * as translucent layers over the window beneath them. Combined with the
 * window opacity setting in the View menu that gives the dark glass look
 * without a frameless window, which would cost the native title bar and
 * every window manager behaviour that goes with it.
 *
 * Branch indicators in QTreeView and the drop down arrow in QComboBox are
 * deliberately left unstyled: without replacement images a stylesheet rule
 * for them renders nothing at all, and an expandable tree with no visible
 * arrows is worse than a slightly inconsistent one.
 */

QWidget {
    background-color: #0b0b0d;
    color: #e6e4dc;
}

QMainWindow, QDialog {
    background-color: #0b0b0d;
}

QToolTip {
    background-color: rgba(28, 28, 33, 245);
    color: #ffd453;
    border: 1px solid #3a3a2e;
    border-radius: 6px;
    padding: 6px 8px;
}

/* ---------------------------------------------------------------- menus --- */

QMenuBar {
    background-color: rgba(20, 20, 23, 200);
    border-bottom: 1px solid #26261f;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    margin: 1px 2px;
    border-radius: 6px;
    color: #e6e4dc;
}

QMenuBar::item:selected {
    background-color: #ffc400;
    color: #121212;
}

QMenuBar::item:disabled {
    color: #6e6b63;
}

QMenu {
    background-color: rgba(20, 20, 23, 248);
    border: 1px solid #3a3a2e;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 6px 28px 6px 24px;
    margin: 1px 2px;
    border-radius: 5px;
    color: #e6e4dc;
}

QMenu::item:selected {
    background-color: #ffc400;
    color: #121212;
}

QMenu::item:disabled {
    color: #6e6b63;
}

QMenu::separator {
    height: 1px;
    background-color: #2d2d26;
    margin: 5px 8px;
}

/* --------------------------------------------------------------- frames --- */

QGroupBox {
    background-color: rgba(20, 20, 23, 160);
    border: 1px solid #26261f;
    border-radius: 10px;
    margin-top: 15px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #ffc400;
    font-weight: bold;
}

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 6px;
}

QSplitter::handle:vertical {
    height: 6px;
}

QSplitter::handle:hover {
    background-color: rgba(255, 196, 0, 90);
    border-radius: 3px;
}

QStatusBar {
    background-color: rgba(20, 20, 23, 200);
    border-top: 1px solid #26261f;
    color: #ffc400;
    padding: 2px 6px;
}

QStatusBar::item {
    border: none;
}

/* ------------------------------------------------------- tree and lists --- */

QTreeView, QListWidget, QListView, QTableView {
    background-color: rgba(16, 16, 19, 190);
    alternate-background-color: rgba(28, 28, 33, 120);
    border: 1px solid #26261f;
    border-radius: 8px;
    padding: 2px;
    color: #e6e4dc;
    selection-background-color: #ffc400;
    selection-color: #121212;
    outline: none;
}

QTreeView::item, QListWidget::item, QListView::item {
    padding: 3px 5px;
    border: none;
    border-radius: 4px;
}

QTreeView::item:hover, QListWidget::item:hover, QListView::item:hover {
    background-color: rgba(255, 196, 0, 28);
}

QTreeView::item:selected, QListWidget::item:selected, QListView::item:selected {
    background-color: #ffc400;
    color: #121212;
}

QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: rgba(28, 28, 33, 220);
    color: #ffc400;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #26261f;
    border-bottom: 1px solid #26261f;
    font-weight: bold;
}

QHeaderView::section:first {
    border-top-left-radius: 7px;
}

QHeaderView::section:last {
    border-right: none;
    border-top-right-radius: 7px;
}

QHeaderView::section:hover {
    background-color: rgba(255, 196, 0, 40);
}

/* ------------------------------------------------------------- editors --- */

QPlainTextEdit, QTextEdit, QTextBrowser {
    background-color: rgba(16, 16, 19, 190);
    border: 1px solid #26261f;
    border-radius: 8px;
    padding: 4px;
    color: #e6e4dc;
    selection-background-color: #ffc400;
    selection-color: #121212;
}

QLineEdit, QSpinBox, QComboBox {
    background-color: rgba(28, 28, 33, 210);
    border: 1px solid #3a3a2e;
    border-radius: 6px;
    padding: 5px 8px;
    color: #e6e4dc;
    selection-background-color: #ffc400;
    selection-color: #121212;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #ffc400;
}

QLineEdit:disabled, QComboBox:disabled {
    color: #6e6b63;
    background-color: rgba(20, 20, 23, 160);
}

QComboBox QAbstractItemView {
    background-color: rgba(20, 20, 23, 248);
    border: 1px solid #3a3a2e;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #ffc400;
    selection-color: #121212;
}

/* ------------------------------------------------------------- buttons --- */

QPushButton {
    background-color: rgba(28, 28, 33, 220);
    border: 1px solid #3a3a2e;
    border-radius: 7px;
    padding: 7px 18px;
    color: #e6e4dc;
}

QPushButton:hover {
    background-color: rgba(255, 196, 0, 30);
    border: 1px solid #ffc400;
    color: #ffd453;
}

QPushButton:pressed {
    background-color: #ffc400;
    color: #121212;
}

QPushButton:default {
    border: 1px solid #ffc400;
    color: #ffc400;
    font-weight: bold;
}

QPushButton:default:hover {
    background-color: #ffc400;
    color: #121212;
}

QPushButton:disabled {
    background-color: rgba(20, 20, 23, 140);
    border: 1px solid #262622;
    color: #6e6b63;
}

/* ------------------------------------------------------- check and radio --- */

QCheckBox, QRadioButton {
    spacing: 8px;
    color: #e6e4dc;
    background: transparent;
}

QCheckBox:disabled, QRadioButton:disabled {
    color: #6e6b63;
}

QCheckBox::indicator, QRadioButton::indicator,
QTreeWidget::indicator, QTreeView::indicator {
    width: 13px;
    height: 13px;
    background-color: rgba(28, 28, 33, 220);
    border: 1px solid #5a5a4a;
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 7px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover,
QTreeWidget::indicator:hover, QTreeView::indicator:hover {
    border: 1px solid #ffc400;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked,
QTreeWidget::indicator:checked, QTreeView::indicator:checked {
    background-color: #ffc400;
    border: 1px solid #ffc400;
}

QCheckBox::indicator:indeterminate,
QTreeWidget::indicator:indeterminate, QTreeView::indicator:indeterminate {
    background-color: #8a6f12;
    border: 1px solid #ffc400;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled,
QTreeWidget::indicator:disabled, QTreeView::indicator:disabled {
    background-color: rgba(20, 20, 23, 140);
    border: 1px solid #262622;
}

/* A selected row is filled with the accent colour, so an accent coloured
 * indicator on it would be invisible. On those rows the indicator inverts:
 * dark border when empty, solid dark fill when ticked. */

QTreeWidget::indicator:selected, QTreeView::indicator:selected {
    background-color: transparent;
    border: 1px solid #121212;
}

QTreeWidget::indicator:checked:selected, QTreeView::indicator:checked:selected {
    background-color: #121212;
    border: 1px solid #121212;
}

/* ----------------------------------------------------------- scrollbars --- */

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: rgba(90, 90, 74, 170);
    min-height: 28px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #ffc400;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(90, 90, 74, 170);
    min-width: 28px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #ffc400;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
    background: none;
    border: none;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ---------------------------------------------------------------- tabs --- */

QTabWidget::pane {
    background-color: rgba(20, 20, 23, 160);
    border: 1px solid #26261f;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: rgba(20, 20, 23, 160);
    border: 1px solid #26261f;
    border-bottom: none;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    padding: 7px 16px;
    margin-right: 2px;
    color: #9a978c;
}

QTabBar::tab:selected {
    background-color: rgba(28, 28, 33, 220);
    color: #ffc400;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: rgba(255, 196, 0, 28);
    color: #e6e4dc;
}

/* -------------------------------------------------------------- labels --- */

QLabel {
    background: transparent;
    color: #e6e4dc;
}

QLabel[accent="true"] {
    color: #ffc400;
    font-weight: bold;
}

QLabel[dim="true"] {
    color: #9a978c;
}

/* The banner above anything destructive. Orange rather than the accent, so
 * it does not read as just another heading. */
QLabel[warning="true"] {
    color: #ff8a3d;
    background-color: rgba(255, 138, 61, 22);
    border: 1px solid rgba(255, 138, 61, 90);
    border-radius: 8px;
    padding: 9px 12px;
}

QProgressBar {
    background-color: rgba(16, 16, 19, 190);
    border: 1px solid #26261f;
    border-radius: 7px;
    text-align: center;
    color: #e6e4dc;
}

QProgressBar::chunk {
    background-color: #ffc400;
    border-radius: 6px;
}
